{
  "name": "@one-take/server",
  "version": "1.0.0",
  "private": true,
  "description": "Local One Take backend: saves exports to a folder of your choosing and packages them with ffmpeg.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "one-take-server": "./dist/index.js",
